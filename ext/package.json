{
  "name": "youtube-bookmarker",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm watch:css\" \"pnpm watch:css-ytb\" \"vite build --watch\"",
    "build": "vue-tsc && vite build",
    "build:ext": "pnpm build:css && pnpm build:css-ytb && vue-tsc && vite build",
    "build:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/output.css",
    "build:css-ytb": "tailwindcss -i ./src/styles/styles-youtube.css -o ./dist/output-ytb.css",
    "watch:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/output.css --watch",
    "watch:css-ytb": "tailwindcss -i ./src/styles/styles-youtube.css -o ./dist/output-ytb.css --watch",
    "type-check": "tsc --noEmit && vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "vue": "3.3.4",
    "tinykeys": "^1.4.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.18.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.14",
    "typescript": "5.0.4",
    "vite": "^5.0.0",
    "vue-tsc": "1.6.5"
  }
}
