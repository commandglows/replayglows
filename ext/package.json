{
  "name": "replayglows-extension",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc && vite build && node scripts/verify-package.mjs",
    "build:ext": "pnpm build",
    "verify:package": "node scripts/verify-package.mjs",
    "build:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/output.css",
    "build:css-ytb": "tailwindcss -i ./src/styles/styles-youtube.css -o ./dist/output-ytb.css",
    "watch:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/output.css --watch",
    "watch:css-ytb": "tailwindcss -i ./src/styles/styles-youtube.css -o ./dist/output-ytb.css --watch",
    "type-check": "tsc --noEmit && vue-tsc --noEmit",
    "lint": "eslint src --fix"
  },
  "dependencies": {
    "tinykeys": "^4.0.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.3.11"
  }
}
