{
  "name": "youtube-bookmarker",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm watch:css\" \"pnpm watch:css-ytb\" \"vite build --watch\"",
    "build": "vue-tsc && vite build",
    "build:ext": "pnpm build:css && pnpm build:css-ytb && vue-tsc && vite build",
    "build:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/output.css",
    "build:css-ytb": "tailwindcss -i ./src/styles/styles-youtube.css -o ./dist/output-ytb.css",
    "watch:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/output.css --watch",
    "watch:css-ytb": "tailwindcss -i ./src/styles/styles-youtube.css -o ./dist/output-ytb.css --watch",
    "type-check": "tsc --noEmit && vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "tinykeys": "^1.4.0",
    "vue": "3.3.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vite": "^6.4.3",
    "vue-tsc": "3.3.9"
  }
}
