{
  "name": "youtube-bookmarker",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm watch:css\" \"pnpm watch:css-ytb\" \"vite build --watch\"",
    "build": "vue-tsc && vite build",
    "build:ext": "pnpm build:css && pnpm build:css-ytb && vue-tsc && vite build",
    "build:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/output.css",
    "build:css-ytb": "tailwindcss -i ./src/styles/styles-youtube.css -o ./dist/output-ytb.css",
    "watch:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/output.css --watch",
    "watch:css-ytb": "tailwindcss -i ./src/styles/styles-youtube.css -o ./dist/output-ytb.css --watch",
    "type-check": "tsc --noEmit && vue-tsc --noEmit",
    "lint": "eslint src --fix"
  },
  "dependencies": {
    "tinykeys": "^4.0.0",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.3.9"
  }
}
