---
import { appSignInRedirectUrl } from '../config/site'

const navItems = [
  { label: 'Benefits', href: '/#benefits' },
  { label: 'Features', href: '/#features' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'Blog', href: '/blog' },
]
---

<header class="site-shell-header animate-slide-down">
  <nav class="relative flex items-center justify-between px-4 py-3 rounded-full bg-background/60 backdrop-blur-md border border-border">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <div class="site-brand-icon-shell">
        <svg viewBox="0 0 32 32" class="site-brand-mark" fill="none" aria-hidden="true">
          <path d="M12 9.5v13l11-6.5L12 9.5Z" />
          <rect x="20" y="14" width="2.5" height="9" rx="1.25" />
        </svg>
      </div>
      <span class="font-semibold text-foreground hidden sm:block">ReplayGlowz</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-1 relative" id="desktop-nav">
      <div id="nav-hover-pill" class="absolute bg-muted site-nav-hover-pill rounded-full opacity-0 pointer-events-none"></div>
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link relative z-10 px-4 py-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- CTA Buttons -->
    <div class="hidden md:flex items-center gap-3">
      <a href="/fr" class="text-sm text-muted-foreground hover:text-foreground transition-colors px-2 py-2" title="Version française">FR</a>
      <a href={appSignInRedirectUrl('/videos')} class="whitespace-nowrap text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2">
        Sign in
      </a>
      <a
        href={appSignInRedirectUrl('/videos')}
        class="shimmer-btn marketing-cta-solid rounded-full px-4 py-2 text-sm font-medium transition-colors"
      >
        Get Started
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-muted-foreground hover:text-foreground"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-5 h-5 menu-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      <svg class="w-5 h-5 close-icon hidden" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden absolute top-full left-0 right-0 mt-2 p-4 rounded-2xl bg-background/95 backdrop-blur-md border border-border">
    <div class="flex flex-col gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link px-4 py-3 text-sm text-muted-foreground hover:text-foreground hover:bg-muted rounded-lg transition-colors"
        >
          {item.label}
        </a>
      ))}
      <hr class="border-border my-2" />
      <a href={appSignInRedirectUrl('/videos')} class="px-4 py-3 text-sm text-muted-foreground hover:text-foreground transition-colors">Sign in</a>
      <a href={appSignInRedirectUrl('/videos')} class="shimmer-btn marketing-cta-solid rounded-full px-4 py-3 text-sm font-medium text-center transition-colors">Get Started</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn')!
  const menu = document.getElementById('mobile-menu')!
  const menuIcon = btn.querySelector('.menu-icon')!
  const closeIcon = btn.querySelector('.close-icon')!

  const setMenuOpen = (isOpen: boolean, restoreFocus = false) => {
    menu.classList.toggle('hidden', !isOpen)
    menuIcon.classList.toggle('hidden', isOpen)
    closeIcon.classList.toggle('hidden', !isOpen)
    btn.setAttribute('aria-expanded', String(isOpen))
    btn.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu')

    if (restoreFocus) btn.focus()
  }

  btn.addEventListener('click', () => {
    setMenuOpen(menu.classList.contains('hidden'))
  })

  menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      setMenuOpen(false)
    })
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
      setMenuOpen(false, true)
    }
  })

  // Navbar hover pill
  const desktopNav = document.getElementById('desktop-nav')!
  const pill = document.getElementById('nav-hover-pill')!
  const navLinks = desktopNav.querySelectorAll('.nav-link')

  navLinks.forEach((link) => {
    link.addEventListener('mouseenter', () => {
      const el = link as HTMLElement
      pill.style.width = `${el.offsetWidth}px`
      pill.style.left = `${el.offsetLeft}px`
      pill.style.top = `${el.offsetTop}px`
      pill.style.opacity = '1'
    })
  })

  desktopNav.addEventListener('mouseleave', () => {
    pill.style.opacity = '0'
  })
</script>
