---
interface Testimonial {
  rating?: number
  review: string
  name: string
  designation: string
  featured?: boolean
}

interface Props {
  items?: Testimonial[]
  ariaLabel?: string
  ratingLabel?: string
}

const defaultTestimonials: Testimonial[] = [
  {
    rating: 5,
    review: 'Great note-taking application! The AI features make note-taking a breeze.',
    name: 'Ryan Lowry',
    designation: 'Engineer & Author',
  },
  {
    rating: 5,
    review: "Really like the clean design of ReplayGlowz. The AI-driven search is impressively accurate, adding a personal dimension to my notes. Fast and very easy to use.",
    name: 'John Collins',
    designation: 'Engineer & Author',
    featured: true,
  },
  {
    rating: 5,
    review: 'Simply brilliant! ReplayGlowz has elevated my productivity.',
    name: 'Moe Partuj',
    designation: 'Student',
  },
]

const {
  items = defaultTestimonials,
  ariaLabel = 'User testimonials',
  ratingLabel = '{rating} out of 5 stars',
} = Astro.props
---

<div
  class="testimonial-rail w-full rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
  role="region"
  aria-label={ariaLabel}
  tabindex="0"
>
  <div class="testimonial-rail__track" data-testimonial-track>
    {[true, false, true].map((isDuplicate) => (
      <div
        class={`testimonial-rail__set ${isDuplicate ? 'testimonial-rail__set--duplicate' : ''}`}
        data-testimonial-set
        role={isDuplicate ? undefined : 'list'}
        aria-hidden={isDuplicate ? 'true' : undefined}
        inert={isDuplicate ? true : undefined}
      >
        {items.map((item) => {
          const rating = item.rating ?? 5

          return (
            <article
              class={`testimonial-rail__card marketing-card flex shrink-0 flex-col text-left border-border ${
                item.featured ? 'bg-background' : 'bg-background/70'
              }`}
              role={isDuplicate ? undefined : 'listitem'}
            >
              <div
                class="mb-4 flex gap-1"
                role={isDuplicate ? undefined : 'img'}
                aria-label={isDuplicate ? undefined : ratingLabel.replace('{rating}', String(rating))}
              >
                {Array.from({ length: rating }).map(() => (
                  <svg class="h-4 w-4 fill-amber-400 text-amber-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                  </svg>
                ))}
              </div>

              <blockquote class="mb-6 flex-1 leading-relaxed text-foreground">
                &ldquo;{item.review}&rdquo;
              </blockquote>

              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-border bg-gradient-to-br from-foreground/20 to-foreground/5 text-xs font-medium text-foreground/60" aria-hidden="true">
                  {item.name[0]}
                </div>
                <div>
                  <p class="text-sm font-medium text-foreground">{item.name}</p>
                  <p class="text-xs text-muted-foreground">{item.designation}</p>
                </div>
              </div>
            </article>
          )
        })}
      </div>
    ))}
  </div>
</div>

<script>
  const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')

  const motionDurationMs = () => {
    const value = getComputedStyle(document.documentElement)
      .getPropertyValue('--motion-duration-testimonial-loop')
      .trim()
    const duration = Number.parseFloat(value)

    if (!Number.isFinite(duration) || duration <= 0) return 0
    return value.endsWith('ms') ? duration : duration * 1000
  }

  document.querySelectorAll<HTMLElement>('.testimonial-rail').forEach((rail) => {
    const track = rail.querySelector<HTMLElement>('[data-testimonial-track]')
    const sets = track?.querySelectorAll<HTMLElement>('[data-testimonial-set]')
    const canonicalSet = sets?.item(1)

    if (!track || !sets || sets.length !== 3 || !canonicalSet) return

    let loopWidth = 0
    let previousFrame = performance.now()
    let animationFrame: number | undefined
    const duration = motionDurationMs()
    const pauseReasons = new Set<string>()

    const resetToCanonicalSet = () => {
      loopWidth = canonicalSet.getBoundingClientRect().width
      if (loopWidth > 0) rail.scrollLeft = reducedMotionQuery.matches ? 0 : loopWidth
    }

    const normalizeScrollPosition = () => {
      if (loopWidth <= 0 || reducedMotionQuery.matches) return

      const maximumScroll = rail.scrollWidth - rail.clientWidth
      const rightBoundary = Math.min(loopWidth * 2, maximumScroll)

      if (rail.scrollLeft >= rightBoundary) {
        rail.scrollLeft -= loopWidth
      } else if (rail.scrollLeft <= 0) {
        rail.scrollLeft += loopWidth
      }
    }

    const canAnimate = () => (
      !document.hidden
      && pauseReasons.size === 0
      && loopWidth > 0
      && duration > 0
    )

    const stopAnimation = () => {
      if (animationFrame === undefined) return
      cancelAnimationFrame(animationFrame)
      animationFrame = undefined
    }

    const scheduleAnimation = (resetClock = false) => {
      if (animationFrame !== undefined || !canAnimate()) return
      if (resetClock) previousFrame = performance.now()
      animationFrame = requestAnimationFrame(animate)
    }

    const syncAnimation = () => {
      if (canAnimate()) scheduleAnimation(true)
      else stopAnimation()
    }

    const setPaused = (reason: string, paused: boolean) => {
      if (paused) pauseReasons.add(reason)
      else pauseReasons.delete(reason)
      syncAnimation()
    }

    rail.addEventListener('scroll', normalizeScrollPosition, { passive: true })
    rail.addEventListener('focusin', () => setPaused('focus', true))
    rail.addEventListener('focusout', (event) => {
      const nextTarget = event.relatedTarget
      if (!(nextTarget instanceof Node) || !rail.contains(nextTarget)) {
        setPaused('focus', false)
      }
    })
    rail.addEventListener('pointerdown', () => setPaused('pointer', true))
    window.addEventListener('pointerup', () => setPaused('pointer', false))
    window.addEventListener('pointercancel', () => setPaused('pointer', false))

    function animate(currentFrame: number) {
      animationFrame = undefined
      if (!canAnimate()) return

      const elapsed = currentFrame - previousFrame
      previousFrame = currentFrame
      rail.scrollLeft += loopWidth * (elapsed / duration)
      normalizeScrollPosition()
      scheduleAnimation()
    }

    document.addEventListener('visibilitychange', syncAnimation)

    const syncReducedMotion = () => {
      setPaused('reduced-motion', reducedMotionQuery.matches)
      resetToCanonicalSet()
    }

    reducedMotionQuery.addEventListener('change', syncReducedMotion)
    syncReducedMotion()
    if ('ResizeObserver' in window) {
      new ResizeObserver(() => {
        resetToCanonicalSet()
        syncAnimation()
      }).observe(rail)
    }
    syncAnimation()
  })
</script>
