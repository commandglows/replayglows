---
interface Props {
  content: {
    label: string
    title: string
    items: readonly {
      icon: string
      title: string
      desc: string
      tag: string
    }[]
  }
}

const { content } = Astro.props
---

<section id="features" class="py-16 sm:py-24 bg-background">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12 sm:mb-16" data-reveal>
      <p class="animate-fade-up text-sm font-medium text-muted-foreground uppercase tracking-wider mb-2">{content.label}</p>
      <h2 class="animate-fade-up delay-100 text-3xl sm:text-4xl font-bold text-foreground mb-4" style="font-family: var(--font-instrument-sans);">
        {content.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-reveal>
      {content.items.map((feature, index) => (
        <div class={`animate-fade-up delay-${index * 100} group h-full flex flex-col items-center text-center marketing-card marketing-card--hover-border bg-card border-border`}>
          <span class="text-4xl sm:text-5xl block mb-4" aria-hidden="true">{feature.icon}</span>
          <h3 class="text-xl sm:text-2xl font-semibold text-foreground mb-3">{feature.title}</h3>
          <p class="text-base text-muted-foreground mb-4 leading-relaxed">{feature.desc}</p>
          <span class="mt-auto inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm">{feature.tag}</span>
        </div>
      ))}
    </div>
  </div>
</section>
