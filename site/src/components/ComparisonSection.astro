---
interface Props {
  content: {
    label: string
    title: string
    intro: string
    leftTitle: string
    rightTitle: string
    rows: readonly {
      before: string
      after: string
    }[]
    closing: string
  }
}

const { content } = Astro.props
---

<section class="py-16 sm:py-24 bg-background">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12 sm:mb-16" data-reveal>
      <p class="animate-fade-up text-sm font-medium text-muted-foreground uppercase tracking-wider mb-2">{content.label}</p>
      <h2 class="animate-fade-up delay-100 text-3xl sm:text-4xl font-bold text-foreground mb-4" style="font-family: var(--font-instrument-sans);">{content.title}</h2>
      <p class="animate-fade-up delay-200 text-lg text-muted-foreground max-w-3xl mx-auto leading-relaxed">{content.intro}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" data-reveal>
      <div class="marketing-card bg-card/70 border-border">
        <h3 class="text-xl sm:text-2xl font-semibold text-muted-foreground mb-6">{content.leftTitle}</h3>
        <ul class="space-y-4">
          {content.rows.map((row) => (
            <li class="flex items-start gap-3 text-muted-foreground leading-relaxed">
              <span class="text-lg" aria-hidden="true">○</span>
              <span>{row.before}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="marketing-card marketing-card--hover-border bg-card border-foreground/30">
        <h3 class="text-xl sm:text-2xl font-semibold text-foreground mb-6">{content.rightTitle}</h3>
        <ul class="space-y-4">
          {content.rows.map((row) => (
            <li class="flex items-start gap-3 text-foreground leading-relaxed">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 6 9 17l-5-5"/></svg>
              <span>{row.after}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="text-center text-lg text-foreground font-medium max-w-3xl mx-auto mt-10 leading-relaxed" data-reveal>{content.closing}</p>
  </div>
</section>
