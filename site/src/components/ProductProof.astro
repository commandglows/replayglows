---
interface Props {
  content: {
    label: string
    title: string
    body: string
    noteLabel: string
    noteText: string
    timestamp: string
    items: readonly {
      icon: string
      title: string
      desc: string
    }[]
  }
}

const { content } = Astro.props
---

<section class="py-16 sm:py-24 bg-card">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div data-reveal>
        <p class="animate-fade-up text-sm font-medium text-muted-foreground uppercase tracking-wider mb-2">{content.label}</p>
        <h2 class="animate-fade-up delay-100 text-3xl sm:text-4xl font-bold text-foreground mb-4" style="font-family: var(--font-instrument-sans);">{content.title}</h2>
        <p class="animate-fade-up delay-200 text-lg text-muted-foreground leading-relaxed">{content.body}</p>
      </div>

      <div class="marketing-card bg-background border-border" data-reveal>
        <div class="flex items-center justify-between gap-4 mb-6">
          <div>
            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-2">{content.noteLabel}</p>
            <p class="text-lg font-semibold text-foreground">{content.noteText}</p>
          </div>
          <span class="shrink-0 rounded-full bg-foreground/10 text-foreground px-3 py-1 text-sm">{content.timestamp}</span>
        </div>

        <div class="grid grid-cols-1 gap-3">
          {content.items.map((item, index) => (
            <div class={`animate-fade-up delay-${(index + 1) * 100} flex items-start gap-4 rounded-xl bg-card border border-border p-4`}>
              <span class="text-2xl" aria-hidden="true">{item.icon}</span>
              <div>
                <h3 class="font-semibold text-foreground mb-1">{item.title}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
