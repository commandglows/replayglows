---
interface Props {
  content: {
    label: string
    title: string
    body: string
    closing: string
  }
}

const { content } = Astro.props
---

<section class="py-16 sm:py-24 bg-card">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center" data-reveal>
      <p class="animate-fade-up text-sm font-medium text-muted-foreground uppercase tracking-wider mb-2">{content.label}</p>
      <h2
        class="animate-fade-up text-3xl sm:text-4xl font-bold text-foreground mb-4"
        style="font-family: var(--font-instrument-sans);"
      >
        {content.title}
      </h2>
      <p class="animate-fade-up delay-100 text-lg sm:text-xl text-muted-foreground leading-relaxed mb-8">{content.body}</p>
      <p class="animate-fade-up delay-200 text-xl sm:text-2xl font-semibold text-foreground leading-relaxed">{content.closing}</p>
    </div>
  </div>
</section>
