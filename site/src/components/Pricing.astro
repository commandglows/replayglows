---
import { appSignInRedirectUrl } from '../config/site'

const plans = [
  {
    name: 'Free',
    description: 'Perfect for getting started',
    priceLabel: '$0',
    features: ['Up to 10 videos', '50 notes per video', '3 playlists'],
    cta: 'Get Started',
    available: true,
  },
  {
    name: 'Pro',
    description: 'For serious learners',
    priceLabel: 'Pricing to be announced',
    features: ['Up to 100 videos', '500 notes per video', '20 playlists', 'AI summaries', 'Note export'],
    cta: 'Coming soon',
    available: false,
  },
]
---

<section id="pricing" class="py-16 sm:py-24 bg-background">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12" data-reveal>
      <h2 class="animate-fade-up text-3xl sm:text-4xl font-bold text-foreground mb-4" style="font-family: var(--font-instrument-sans);">
        Free now, Pro coming soon
      </h2>
      <p class="animate-fade-up delay-100 text-muted-foreground max-w-2xl mx-auto mb-8">
        Start with Free. We’ll announce Pro pricing when it’s ready.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-reveal>
      {plans.map((plan, index) => (
        <div
          class={`animate-fade-up-slow delay-${300 + index * 100} marketing-card bg-card/70 border-border marketing-card--hover-border`}
        >
          <div class="mb-6">
            <h3 class="text-xl font-semibold text-foreground mb-2">{plan.name}</h3>
            <p class="text-muted-foreground text-sm">{plan.description}</p>
          </div>

          <div class="mb-6">
            <span class={plan.available ? 'text-4xl font-bold text-foreground' : 'text-lg font-semibold text-foreground'}>{plan.priceLabel}</span>
          </div>

          <ul class="space-y-3 mb-8">
            {plan.features.map((feature) => (
              <li class="flex items-center gap-3 text-sm text-foreground/85">
                <svg class="w-4 h-4 text-emerald-500 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                {feature}
              </li>
            ))}
          </ul>

          {plan.available ? (
            <a href={appSignInRedirectUrl('/videos')} class="block w-full text-center rounded-full py-3 text-sm font-medium transition-colors shimmer-btn marketing-cta-solid">{plan.cta}</a>
          ) : (
            <span class="block w-full text-center rounded-full py-3 text-sm font-medium border border-border text-muted-foreground">{plan.cta}</span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
