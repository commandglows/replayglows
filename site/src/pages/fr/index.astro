---
import ExtensionTeaser from '../../components/ExtensionTeaser.astro'
import Layout from '../../layouts/Layout.astro'
import { getTranslations } from '../../i18n'
import { appSignInRedirectUrl } from '../../config/site'
import Hero from '../../components/Hero.astro'
import ProblemSection from '../../components/ProblemSection.astro'
import SolutionSection from '../../components/SolutionSection.astro'
import ProductProof from '../../components/ProductProof.astro'
import ComparisonSection from '../../components/ComparisonSection.astro'
import FinalCTA from '../../components/FinalCTA.astro'
import Benefits from '../../components/Benefits.astro'
import BentoGrid from '../../components/BentoGrid.astro'
import FocusSection from '../../components/FocusSection.astro'
import ClosingCTA from '../../components/ClosingCTA.astro'

const t = getTranslations('fr')
const appUrlValue = appSignInRedirectUrl('/videos')
---

<Layout
  title="ReplayGlows — Garde ce que tu apprends sur YouTube"
  description="Prends des notes horodatées, organise tes vidéos YouTube et retrouve le passage exact qui donne son contexte à chaque idée utile."
  path="/fr"
  lang="fr"
>
  <main id="main-content" class="min-h-screen bg-background text-foreground">

    <!-- Navbar -->
    <header class="site-shell-header animate-slide-down">
      <nav class="relative flex items-center justify-between px-4 py-3 rounded-full bg-background/60 backdrop-blur-md border border-border">
        <a href="/fr" class="flex items-center gap-2">
          <div class="site-brand-icon-shell">
            <svg viewBox="0 0 32 32" class="site-brand-mark" fill="none">
              <path d="M12 9.5v13l11-6.5L12 9.5Z" />
              <rect x="20" y="14" width="2.5" height="9" rx="1.25" />
            </svg>
          </div>
          <span class="font-semibold text-foreground hidden sm:block">ReplayGlows</span>
        </a>
        <div class="hidden md:flex items-center gap-1">
          <a href="/fr/extension" class="px-4 py-2 text-sm text-muted-foreground hover:text-foreground">Extension</a>
          <a href="#benefits" class="px-4 py-2 text-sm text-muted-foreground hover:text-foreground hover:bg-muted rounded-full transition-colors">{t.nav.benefits}</a>
          <a href="#features" class="px-4 py-2 text-sm text-muted-foreground hover:text-foreground hover:bg-muted rounded-full transition-colors">{t.nav.features}</a>
          <a href="#pricing" class="px-4 py-2 text-sm text-muted-foreground hover:text-foreground hover:bg-muted rounded-full transition-colors">{t.nav.pricing}</a>
        </div>
        <div class="hidden md:flex items-center gap-3">
          <a href="/" class="text-sm text-muted-foreground hover:text-foreground transition-colors px-2 py-2" title="English version">EN</a>
          <a href={appUrlValue} class="whitespace-nowrap text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2">{t.nav.signIn}</a>
          <a href={appUrlValue} class="shimmer-btn marketing-cta-solid rounded-full px-4 py-2 text-sm font-medium transition-colors">{t.nav.getStarted}</a>
        </div>
        <button id="fr-mobile-menu-btn" class="md:hidden p-2 text-muted-foreground hover:text-foreground" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="fr-mobile-menu">
          <svg class="w-5 h-5 fr-menu-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          <svg class="w-5 h-5 fr-close-icon hidden" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </nav>
      <div id="fr-mobile-menu" class="hidden absolute top-full left-0 right-0 mt-2 p-4 rounded-2xl bg-background/95 backdrop-blur-md border border-border">
        <div class="flex flex-col gap-2">
          <a href="#benefits" class="fr-mobile-link px-4 py-3 text-sm text-muted-foreground hover:text-foreground hover:bg-muted rounded-lg transition-colors">{t.nav.benefits}</a>
          <a href="/fr/extension" class="fr-mobile-link px-4 py-3 text-sm text-muted-foreground hover:text-foreground">Extension</a>
          <a href="#features" class="fr-mobile-link px-4 py-3 text-sm text-muted-foreground hover:text-foreground hover:bg-muted rounded-lg transition-colors">{t.nav.features}</a>
          <a href="#pricing" class="fr-mobile-link px-4 py-3 text-sm text-muted-foreground hover:text-foreground hover:bg-muted rounded-lg transition-colors">{t.nav.pricing}</a>
          <hr class="border-border my-2" />
          <a href={appUrlValue} class="px-4 py-3 text-sm text-muted-foreground hover:text-foreground transition-colors">{t.nav.signIn}</a>
          <a href={appUrlValue} class="shimmer-btn marketing-cta-solid rounded-full px-4 py-3 text-sm font-medium text-center transition-colors">{t.nav.getStarted}</a>
        </div>
      </div>
    </header>
    <script>
      const btn = document.getElementById('fr-mobile-menu-btn')!
      const menu = document.getElementById('fr-mobile-menu')!

      const setMenuOpen = (isOpen: boolean, restoreFocus = false) => {
        menu.classList.toggle('hidden', !isOpen)
        btn.querySelector('.fr-menu-icon')!.classList.toggle('hidden', isOpen)
        btn.querySelector('.fr-close-icon')!.classList.toggle('hidden', !isOpen)
        btn.setAttribute('aria-expanded', String(isOpen))
        btn.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu')

        if (restoreFocus) btn.focus()
      }

      btn.addEventListener('click', () => {
        setMenuOpen(menu.classList.contains('hidden'))
      })

      menu.querySelectorAll('a').forEach(l => l.addEventListener('click', () => {
        setMenuOpen(false)
      }))

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
          setMenuOpen(false, true)
        }
      })
    </script>

    <Hero
      content={t.hero}
      testimonials={t.testimonials.items}
      testimonialLabel={t.testimonials.title}
      ratingLabel="{rating} étoiles sur 5"
    />
    <ProblemSection content={t.problem} />
    <SolutionSection content={t.solution} />
    <ProductProof content={t.productProof} />
    <ExtensionTeaser lang="fr" />
    <ComparisonSection content={t.comparison} />

    <!-- Pricing -->
    <section id="pricing" class="py-16 sm:py-24 bg-background">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-foreground mb-4" style="font-family: var(--font-instrument-sans);">{t.pricing.title}</h2>
          <p class="text-muted-foreground max-w-2xl mx-auto mb-8">{t.pricing.subtitle}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {t.pricing.plans.map(plan => (
            <div class={`relative marketing-card ${plan.highlighted ? 'bg-card border-foreground/30' : 'bg-card/70 border-border marketing-card--hover-border'}`}>
              {plan.highlighted && <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-foreground text-background text-xs font-medium rounded-full">{t.pricing.mostPopular}</div>}
              <div class="mb-6"><h3 class="text-xl font-semibold text-foreground mb-2">{plan.name}</h3><p class="text-muted-foreground text-sm">{plan.desc}</p></div>
              <div class="mb-6"><div class="flex items-baseline gap-1"><span class="text-4xl font-bold text-foreground">${plan.monthly}</span>{plan.monthly > 0 && <span class="text-muted-foreground text-sm">{t.pricing.perMonth}</span>}</div></div>
              <ul class="space-y-3 mb-8">
                {plan.features.map(f => (
                  <li class="flex items-center gap-3 text-sm text-foreground/85">
                    <svg class="w-4 h-4 text-emerald-500 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 6 9 17l-5-5"/></svg>
                    {f}
                  </li>
                ))}
              </ul>
              <a href={appUrlValue} class={`block w-full text-center rounded-full py-3 text-sm font-medium transition-colors ${plan.highlighted ? 'shimmer-btn marketing-cta-solid' : 'bg-card text-foreground hover:bg-muted border border-border'}`}>{plan.cta}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FinalCTA content={t.finalCta} />
    <Benefits content={t.benefits} />
    <BentoGrid content={t.features} />
    <FocusSection content={t.focus} />
    <ClosingCTA content={t.closingCta} />

    <!-- Footer -->
    <footer class="border-t border-border bg-background">
      <div class="max-w-6xl mx-auto px-4 py-16">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
          <div class="col-span-2 md:col-span-1">
            <a href="/fr" class="flex items-center gap-2 mb-4">
              <div class="site-brand-icon-shell">
                <svg viewBox="0 0 32 32" class="site-brand-mark" fill="none">
                  <path d="M12 9.5v13l11-6.5L12 9.5Z" />
                  <rect x="20" y="14" width="2.5" height="9" rx="1.25" />
                </svg>
              </div>
              <span class="font-semibold text-foreground">ReplayGlows</span>
            </a>
            <p class="text-sm text-muted-foreground/70 mb-4">{t.footer.tagline}</p>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-card border border-border">
              <span class="w-2 h-2 rounded-full bg-emerald-500 pulse-glow"></span>
              <span class="text-xs text-muted-foreground">{t.footer.status}</span>
            </div>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-foreground mb-4">{t.footer.product}</h4>
            <ul class="space-y-3">
              <li><a href="/fr/extension" class="text-sm text-muted-foreground/70 hover:text-foreground transition-colors">Extension</a></li>
              <li><a href="/fr/extension/guide" class="text-sm text-muted-foreground/70 hover:text-foreground transition-colors">Guide de l’extension</a></li>
              <li><a href="/fr#features" class="text-sm text-muted-foreground/70 hover:text-foreground transition-colors">{t.nav.features}</a></li>
              <li><a href="/fr#pricing" class="text-sm text-muted-foreground/70 hover:text-foreground transition-colors">{t.nav.pricing}</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-foreground mb-4">{t.footer.resources}</h4>
            <ul class="space-y-3">
              <li><a href="/blog" class="text-sm text-muted-foreground/70 hover:text-foreground transition-colors">{t.nav.blog}</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-foreground mb-4">{t.footer.legal}</h4>
            <ul class="space-y-3">
              <li><a href="/privacy" class="text-sm text-muted-foreground/70 hover:text-foreground transition-colors">Confidentialité</a></li>
              <li><a href="/terms" class="text-sm text-muted-foreground/70 hover:text-foreground transition-colors">Conditions</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-16 pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-sm text-muted-foreground/70">{t.footer.copyright.replace('{year}', String(new Date().getFullYear()))}</p>
          <a href="/" class="text-sm text-muted-foreground/70 hover:text-foreground transition-colors">English</a>
        </div>
      </div>
    </footer>

</main>
</Layout>
