---
import Layout from '../layouts/Layout.astro'

const secretCode = 'i}Z43gM_wOjBY%JHA>XX7xEn?m!)!0J)!=:o622f5}woH%wi^hz0&<H>;dTmVSr'
---

<Layout title="MDP" description="Copier le code" path="/mdp" noIndex={true} lang="fr">
  <main
    id="main-content"
    class="flex min-h-screen items-center justify-center bg-background px-6 py-16 text-foreground"
  >
    <section class="w-full max-w-3xl rounded-3xl border border-black/10 bg-white/80 p-8 shadow-[0_24px_80px_rgba(0,0,0,0.08)] backdrop-blur">
      <div class="space-y-6">
        <h1 class="text-3xl font-semibold tracking-tight">Code</h1>
        <p
          id="secret-code"
          class="overflow-x-auto rounded-2xl bg-black px-4 py-5 font-mono text-sm leading-7 text-white"
        >
          {secretCode}
        </p>
        <button
          id="copy-button"
          type="button"
          data-code={secretCode}
          class="inline-flex items-center justify-center rounded-full bg-foreground px-5 py-3 text-sm font-semibold text-background transition hover:opacity-90"
        >
          Copier le code
        </button>
      </div>
    </section>
  </main>

  <script is:inline>
    const button = document.getElementById('copy-button')
    const originalLabel = button?.textContent ?? 'Copier le code'

    button?.addEventListener('click', async () => {
      const code = button.getAttribute('data-code')
      if (!code) return

      try {
        await navigator.clipboard.writeText(code)
        button.textContent = 'Copie effectuee'
        window.setTimeout(() => {
          button.textContent = originalLabel
        }, 2000)
      } catch {
        button.textContent = 'Copie impossible'
      }
    })
  </script>
</Layout>
