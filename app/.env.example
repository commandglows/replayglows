# Safe placeholders only. Do not put real secrets in committed example files.

# Build-time Flutter web configuration
CONVEX_URL=https://your-deployment.convex.cloud
CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
# Native Firebase configuration (non-web auth)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_DEV_API_KEY=your_firebase_api_key
FIREBASE_DEV_APP_ID=your_firebase_app_id
FIREBASE_DEV_MESSAGING_SENDER_ID=your_firebase_sender_id
FIREBASE_DEV_AUTH_DOMAIN=your-firebase-app.firebaseapp.com
FIREBASE_DEV_STORAGE_BUCKET=your-firebase-project.appspot.com
FIREBASE_WEB_CLIENT_ID=your_firebase_web_client_id
SUITE_IDENTITY_BRIDGE_URL=https://www.winflowz.com/api/bridge/firebase
REPLAYGLOWS_PRODUCT_ID=replayglows
REPLAYGLOWS_LEGACY_PRODUCT_IDS=tubeflow
REPLAYGLOWS_ACCOUNT_CENTER_URL=https://winflows.com/account
REPLAYGLOWS_APP_URL=https://app.replayglowz.com
# Optional build metadata surfaced in diagnostics.
BUILD_COMMIT_SHA=local
BUILD_ID=local
BUILD_ENVIRONMENT=local
BUILD_TIMESTAMP=2026-05-10T00:00:00Z
BUILD_AT_PARIS=2026-05-10 02:00
BUILD_AT_UTC=2026-05-10T00:00:00Z
# Optional Sentry observability. Leave empty to disable locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=replayglows_app@local
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DEBUG=false

# Server-side secrets for Vercel OAuth callback handling
YOUTUBE_OAUTH_CLIENT_ID=your-youtube-oauth-client-id.apps.googleusercontent.com
YOUTUBE_OAUTH_CLIENT_SECRET=your-youtube-oauth-client-secret
CLERK_SECRET_KEY=sk_live_xxx
SUITE_ENTITLEMENT_VERIFY_URL=https://www.winflowz.com/api/bridge/entitlement
SUITE_ENTITLEMENT_VERIFY_SECRET=replace-with-strong-secret
REPLAYGLOWS_YOUTUBE_OAUTH_TICKET_SECRET=replace-with-strong-ticket-secret
